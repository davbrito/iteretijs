{
  "name": "iteretijs",
  "version": "0.3.1",
  "description": "Set of JavaScript iterator, generator and stream utilities",
  "keywords": [
    "async",
    "generators",
    "iterators",
    "javascript",
    "typescript"
  ],
  "homepage": "https://github.com/davbrito/iteretijs#readme",
  "bugs": {
    "url": "https://github.com/davbrito/iteretijs/issues"
  },
  "license": "MIT",
  "author": "David Brito",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davbrito/iteretijs.git"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./async": "./dist/async.mjs",
    "./stream": "./dist/stream.mjs",
    "./package.json": "./package.json",
    "./sync": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only",
    "check:package": "publint && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^24.11.0 || >=26"
  }
}
