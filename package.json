{
  "name": "iteretijs",
  "version": "0.2.3",
  "description": "Set of JavaScript iterator, generator and stream utilities",
  "keywords": [
    "async",
    "generators",
    "iterators",
    "javascript",
    "typescript"
  ],
  "homepage": "https://github.com/davbrito/iteretijs#readme",
  "bugs": {
    "url": "https://github.com/davbrito/iteretijs/issues"
  },
  "license": "MIT",
  "author": "David Brito",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davbrito/iteretijs.git"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "package.json"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./async": {
      "types": "./dist/async.d.ts",
      "import": "./dist/async.js",
      "require": "./dist/async.cjs"
    },
    "./sync": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./stream": {
      "types": "./dist/stream.d.ts",
      "import": "./dist/stream.js",
      "require": "./dist/stream.cjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "glob": "^13.0.6",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
